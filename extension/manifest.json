{
  "manifest_version": 2,
  "name": "Banking Aid statement fetcher",
  "version": "1.0.19",
  "description": "On your bank's statements page, finds the statements your Banking Aid is missing, downloads each one and sends it straight to Banking Aid.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "log.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Banking Aid statement fetcher",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "statement-fetcher@tomshomelab.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/tomshomelab/statement-fetcher/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
